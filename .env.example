# LLM provider: openai, openrouter, anthropic, or ollama
RESBOT_LLM_PROVIDER=openai

# Model to use (defaults per provider are used if unset)
# RESBOT_LLM_MODEL=gpt-4o-mini

# API keys (one per provider you use; ollama needs none)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override the provider's default base URL
# RESBOT_LLM_BASE_URL=
